+# route_file() answers the request from routes/ when routes/ has a directory for its path:
+#   routes/NAME/METHOD.sh handles METHOD /NAME, and a directory named @ matches any one path
+#   segment and passes it on as an argument, e.g. routes/topics/@/PUT.sh handles PUT /topics/news
+#   with $1=news.  Handlers are sourced, so they can use send_response() and friends.
+# it exits once it has answered, and returns otherwise, leaving the request to sampo.conf
+route_file() {
+  local dir="$DIR/routes" segment
+  local -a segments=() args=()
+  IFS=/ read -r -a segments <<< "${REQUEST_URI#/}"
+  for segment in "${segments[@]}"; do
+    # only plain names can select a directory, which also rules out ../
+    if [[ "$segment" =~ ^[A-Za-z0-9_-]+$ ]] && [[ -d "$dir/$segment" ]]; then
+      dir="$dir/$segment"
+    elif [[ -d "$dir/@" ]]; then
+      dir="$dir/@"
+      args+=("$segment")
+    else
+      return 0
+    fi
+  done
+  if [[ "$dir" == "$DIR/routes" ]]; then
+    return 0
+  fi
+
+  if [[ ! "$REQUEST_METHOD" =~ ^(GET|POST|PUT|DELETE)$ ]]; then
+    send_response 501 < <(echo "$REQUEST_METHOD is invalid or not yet implemented. $FUNDING")
+  elif [[ -f "$dir/$REQUEST_METHOD.sh" ]]; then
+    #shellcheck source=/dev/null
+    source "$dir/$REQUEST_METHOD.sh" "${args[@]}"
+  else
+    # the Allow header lists the methods that do have a file
+    local -a allowed=("$dir"/*.sh)
+    allowed=("${allowed[@]##*/}")
+    append_header "Allow" "$(IFS=,; echo "${allowed[*]%.sh}")"
+    fail_with 405
+  fi
+  exit 0
+}
