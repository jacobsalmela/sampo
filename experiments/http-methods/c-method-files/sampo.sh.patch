   append_header "Content-Type" "text/plain"
 
-  send_response 200 < <(printf '%s\n' "${ENDPOINTS_FUNCTIONS[@]}")
+  send_response 200 < <(printf '%s\n' "${ENDPOINTS_FUNCTIONS[@]}"; list_file_routes)
+}
+
+# list_file_routes() lists the handlers in routes/ as "METHOD /path:file"
+list_file_routes() {
+  local file route
+  [[ -d "$DIR/routes" ]] || return 0
+  while IFS= read -r file; do
+    route="${file#"$DIR"/routes}"
+    printf '%s %s:%s\n' "$(basename "$route" .sh)" "${route%/*}" "routes$route"
+  done < <(find "$DIR/routes" -name '*.sh' | sort)
 }
 
 
